# คัดลอกเป็น .env แล้วปรับค่าตามจริง (ไฟล์ .env ไม่ขึ้น git)
# ---- Infra ----
DATABASE_URL=postgresql+asyncpg://rejoin:rejoin@localhost:5432/rejoin
REDIS_URL=redis://localhost:6379/0
# dev (ไม่ตั้ง DATABASE_URL/REDIS_URL) จะใช้ SQLite + fakeredis อัตโนมัติ

# ---- Security / session ----
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# ---- Discord OAuth2 ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback

# ---- Dev ----
DEV_AUTH=true            # เปิด /auth/dev (ปิดใน production)

# ---- Watchdog ฝั่งเว็บ ----
OFFLINE_AFTER_SEC=30
SILENCE_SEC=60
HEARTBEAT_INTERVAL_SEC=15
LAST_SEEN_TTL_SEC=120

# ---- ไฟล์ ----
LUA_DIR=skeleton/lua
APK_PATH=                    # ที่อยู่ไฟล์ APK ให้ดาวน์โหลด (ว่าง = หาใน dist/*.apk อัตโนมัติ)

# ---- Retention ของประวัติ (events) — กัน DB/หน้ายาวมหาศาล ----
EVENT_RETENTION_DAYS=30      # ลบเหตุการณ์ที่เก่ากว่านี้
EVENT_MAX_PER_DEVICE=200     # เก็บต่อเครื่องไว้ไม่เกินกี่แถวล่าสุด
RETENTION_INTERVAL_SEC=21600 # ทำงานลบของเก่าซ้ำทุก 6 ชม. (ตอนรันเซิร์ฟเวอร์)

# ---- ตัวรัน (Runner) — ลิงก์หน้า /bypass (ว่าง = โชว์ "กำลังพัฒนา") ----
RUNNER_URL=
