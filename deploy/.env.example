# คัดลอกเป็น deploy/.env แล้วแก้ค่าจริง (ห้าม commit .env)
# ---- โดเมน (ต้องชี้ A record มาที่ IP เครื่องนี้แล้ว) ----
DOMAIN=rejoin.thirx.com

# ---- รหัสฐานข้อมูล (ตั้งให้เดายาก) ----
POSTGRES_PASSWORD=change-me-strong-password

# ---- session cookie (สุ่มยาวๆ: openssl rand -hex 32) ----
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Discord OAuth2 (https://discord.com/developers/applications) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://rejoin.thirx.com/auth/discord/callback

# ---- ลิงก์ชุมชน Discord (ปุ่ม "เข้าร่วมชุมชน" ทั้งหน้า login และในเว็บ) ----
DISCORD_INVITE_URL=https://discord.gg/N7Kuayuzxb

# ---- APK ให้ดาวน์โหลด ----
# production ไม่มีไฟล์ dist/ ใน image → ใช้ลิงก์ GitHub Release ที่ Actions อัปโหลด (ค่า default ด้านล่าง)
# APK_URL=https://github.com/ffxlm/rejoin-cloud/releases/download/apk-latest/rejoin-agent-debug.apk

# ---- หมายเหตุ ----
# COOKIE_SECURE / DEV_AUTH / DATABASE_URL / REDIS_URL ถูกตั้งใน compose ให้แล้ว
# OFFLINE_AFTER_SEC / SILENCE_SEC / HEARTBEAT_INTERVAL_SEC ใช้ค่า default ได้
# EVENT_RETENTION_DAYS (default 30) / EVENT_MAX_PER_DEVICE (default 200) = ลบประวัติเก่า
