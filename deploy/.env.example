# คัดลอกเป็น deploy/.env แล้วแก้ค่าจริง (ห้าม commit .env)
# ---- โดเมน (ต้องชี้ A record มาที่ IP เครื่องนี้แล้ว) ----
DOMAIN=rejoin.example.com

# ---- รหัสฐานข้อมูล (ตั้งให้เดายาก) ----
POSTGRES_PASSWORD=change-me-strong-password

# ---- session cookie (สุ่มยาวๆ: openssl rand -hex 32) ----
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Discord OAuth2 (https://discord.com/developers/applications) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://rejoin.example.com/auth/discord/callback

# ---- หมายเหตุ ----
# COOKIE_SECURE / DEV_AUTH / DATABASE_URL / REDIS_URL ถูกตั้งใน compose ให้แล้ว
# OFFLINE_AFTER_SEC / SILENCE_SEC / HEARTBEAT_INTERVAL_SEC ใช้ค่า default ได้
# EVENT_RETENTION_DAYS (default 30) / EVENT_MAX_PER_DEVICE (default 200) = ลบประวัติเก่า
